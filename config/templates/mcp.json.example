{
  "enabled": true,
  "use_in_chat": true,
  "max_agent_steps": 12,
  "tool_result_max_chars": 12000,
  "default_call_timeout": 120.0,
  "preload_on_startup": false,
  "servers": [
    {
      "id": "playwright",
      "name": "Playwright 浏览器",
      "enabled": true,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--browser=msedge"],
      "env": {"PLAYWRIGHT_MCP_BROWSER": "msedge"},
      "tool_prefix": ""
    },
    {
      "id": "filesystem",
      "name": "项目代码",
      "enabled": true,
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:/Project/pnn_garden"
      ],
      "env": {},
      "tool_prefix": ""
    }
  ]
}
