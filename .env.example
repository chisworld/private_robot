# 复制本文件为项目根目录的 `.env`，填入真实密钥（`.env` 已被 Git 忽略）

# ---------- LLM（DeepSeek / OpenAI 兼容）----------
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 也可用通用变量名（与上面二选一即可）
# OPENAI_API_KEY=
# OPENAI_API_BASE=

# ---------- 本地 API 网关（桌宠 / 网页）----------
PNN_API_HOST=127.0.0.1
PNN_API_PORT=8765

# ---------- TTS ----------
TTS_SERVER_URL=http://127.0.0.1:9880
# 云厂商 TTS（Genie 等）API Key
TTS_API_KEY=

# ---------- 百度翻译（气泡显示中文，TTS 仍用 AI 原文）----------
# BAIDU_TRANSLATE_APP_ID=
# BAIDU_TRANSLATE_SECRET=

# ---------- ASR / 模型下载（可选）----------
HF_ENDPOINT=https://hf-mirror.com

# ---------- Live2D 桌宠模型目录（可选，默认自动查找）----------
# LIVE2D_MODEL_DIR=D:/Project/pnn_garden/14酱

# ---------- 日志 ----------
# LOG_LEVEL=INFO
